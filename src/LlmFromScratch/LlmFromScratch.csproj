<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseCuda>false</UseCuda>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TorchSharp-cpu" Version="0.106.0" Condition="'$(UseCuda)' != 'true'" />
    <PackageReference Include="TorchSharp-cuda-windows" Version="0.106.0" Condition="'$(UseCuda)' == 'true'" />
  </ItemGroup>

</Project>
